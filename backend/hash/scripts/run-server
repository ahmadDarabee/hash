#!usr/bin/env python3

import logging
import asyncio
import argparse

import backend 
from backend.config import get_setting
from backend.logging.filter import RedactFilter

import uvicorn
import uvicorn.server


logging.basicConfig(level=logging.INFO)

uvlogger = logging.getLogger("uvicorn.access")
uvlogger.addFilter(RedactFilter())

logger = logging.getLogger(__name__)
setting= get_setting()

async def main():
    app = backend.app

    config = uvicorn.Config(
        app,
        port=LISTEN_PORT,
        log_config=LOG_CONFIG,
        reload=False,
        host="0.0.0.0", # makes the server available on all the network interface.
        proxy_headers=True # trust the headers from proxies like X-Forwarded-FOR, X-Real-IP, so the correct client ip are logged.
         
    
    )

    server = uvicorn.server(config)
    await server.serve()

if __name__ =="__main__":
    LOG_CONFIG = setting.log_config
    LISTEN_PORT= setting.port
    asyncio.run(main())